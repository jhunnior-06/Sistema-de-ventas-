# Desarrollo local: SQLite se crea automáticamente si DATABASE_URL queda vacío.
# Producción (Vercel): configura todas estas variables.
DATABASE_URL=postgresql+psycopg://usuario:contrasena@host:5432/sistema_ventas
SECRET_KEY=coloca-aqui-una-clave-larga-y-aleatoria
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=cambia-esta-contrasena-inicial
